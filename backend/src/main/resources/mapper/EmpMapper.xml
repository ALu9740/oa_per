<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa_server.module.emp.mapper.EmpMapper">

    <!-- 通用结果映射 -->
    <resultMap id="EmpResultMap" type="com.oa_server.module.emp.entity.Emp">
        <id column="id" property="id"/>
        <result column="emp_no" property="empNo"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="password" property="password"/>
        <result column="dept_id" property="deptId"/>
        <result column="job_id" property="jobId"/>
        <result column="hire_date" property="hireDate"/>
        <result column="role_type" property="roleType"/>
        <result column="account_status" property="accountStatus"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="id_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 根据邮箱查询用户 -->
    <select id="findByEmail" resultMap="EmpResultMap">
        SELECT * FROM `emp`
        WHERE is_deleted = 0 AND email = #{email}
            LIMIT 1
    </select>

    <!-- 新增员工 -->
    <insert id="insertEmp" parameterType="com.oa_server.module.emp.entity.Emp">
        INSERT INTO `emp` (id, emp_no, email, password, role_type, account_status)
        VALUES (#{id}, #{empNo}, #{email}, #{password},#{roleType},#{accountStatus})
    </insert>

    <!-- 根据主键查询 -->
    <select id="findById" resultMap="EmpResultMap">
        SELECT * FROM `emp`
        WHERE is_deleted = 0 AND id = #{id}
            LIMIT 1
    </select>

    <!-- 完善资料：只在"待完善(2)"状态下允许更新，更新后状态置1 -->
    <update id="updateProfile">
        UPDATE `emp`
        SET name         = #{name},
            gender       = #{gender},
            phone        = #{phone},
            account_status = #{accountStatus}
        WHERE id = #{id} AND is_deleted = 0 AND account_status = 2
    </update>

    <!-- 重置密码 -->
    <update id="resetPassword">
        UPDATE `emp`
        SET password = #{password}
        WHERE id = #{id} AND is_deleted = 0
    </update>

</mapper>
